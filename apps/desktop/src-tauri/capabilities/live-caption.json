{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "live-caption",
  "description": "Live caption overlay webview (currently never created). Its own state command plus the shared boot path (ASPC A2.5).",
  "windows": [
    "live-caption"
  ],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:window:allow-set-theme",
    "core:webview:allow-set-webview-zoom",
    "core:app:default",
    "windows:allow-webview-health-ack",
    "windows:allow-webview-health-ready",
    "windows:allow-live-caption-current-state",
    "db:allow-wait-until-ready",
    "db:allow-get-startup-status",
    "db:allow-subscribe",
    "db:allow-unsubscribe",
    "db:allow-execute",
    "local-auth:allow-available",
    "local-auth:allow-authenticate",
    "icon:allow-set-dock-icon",
    "tracing:allow-do-log"
  ]
}
