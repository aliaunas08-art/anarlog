{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "floating-bar",
  "description": "Floating recording bar webview (Windows/Linux only; macOS uses a native panel). Its own state command plus what the shared boot path needs to render settings and theme (ASPC A2.5).",
  "windows": [
    "floating-bar"
  ],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:window:allow-set-theme",
    "core:webview:allow-set-webview-zoom",
    "core:app:default",
    "windows:allow-webview-health-ack",
    "windows:allow-webview-health-ready",
    "windows:allow-floating-bar-current-state",
    "db:allow-wait-until-ready",
    "db:allow-get-startup-status",
    "db:allow-subscribe",
    "db:allow-unsubscribe",
    "db:allow-execute",
    "local-auth:allow-available",
    "local-auth:allow-authenticate",
    "icon:allow-set-dock-icon",
    "tracing:allow-do-log"
  ]
}
